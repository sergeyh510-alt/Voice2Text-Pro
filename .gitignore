.idea/misc.xml
.idea/vcs.xml
.idea/dictionaries/
.idea/runConfigurations/

# ================================================================
# 2. ФАЙЛЫ СБОРКИ GRADLE
# ================================================================

# Gradle build output
build/
app/build/
.gradle/

# Gradle wrapper (сохраняем только .properties)
gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# Gradle cache
gradle-app.setting

